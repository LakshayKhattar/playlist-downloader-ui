# App identity
NODE_ENV=production
APP_NAME=Playlist Downloader
APP_REPOSITORY_URL=https://github.com/LakshayKhattar/playlist-downloader-ui

# Leave blank for direct local use. For an authenticated same-host reverse proxy,
# set the exact external HTTPS origin, for example https://downloads.example.com.
APP_PUBLIC_URL=

# Local service ports
PORT=4173
DEV_PORT=5173

# Storage. PLAYLIST_DOWNLOADS_ROOT must be absolute when set.
PLAYLIST_DOWNLOADS_ROOT=
DOWNLOADS_LABEL=downloads

# Download defaults and safety limits
DEFAULT_QUALITY=best
MAX_PLAYLIST_ITEMS=500
MAX_TOTAL_DURATION_SECONDS=259200
MAX_DOWNLOAD_BYTES=85899345920
MIN_FREE_BYTES=4294967296
MAX_JOB_RUNTIME_MS=86400000
DOWNLOAD_INACTIVITY_MS=900000
MAX_DOWNLOAD_PASSES=3
MAX_SSE_CLIENTS=4

# Optional absolute executable paths; leave blank to resolve from PATH.
YT_DLP_BIN=
FFMPEG_BIN=
FFPROBE_BIN=
