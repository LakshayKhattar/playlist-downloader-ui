{
  "name": "playlist-downloader-ui",
  "version": "1.0.0",
  "description": "A secure, resumable local web interface for downloading and verifying YouTube playlists with yt-dlp.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Lakshay Khattar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LakshayKhattar/playlist-downloader-ui.git"
  },
  "bugs": {
    "url": "https://github.com/LakshayKhattar/playlist-downloader-ui/issues"
  },
  "homepage": "https://github.com/LakshayKhattar/playlist-downloader-ui#readme",
  "keywords": [
    "yt-dlp",
    "playlist",
    "react",
    "express",
    "ffmpeg"
  ],
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.js",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "node --test test/config.test.js test/progress.test.js test/validation.test.js test/security.test.js",
    "test:security": "node --test test/security.test.js",
    "test:ui": "node test/ui-e2e.mjs",
    "audit:offline": "npm audit --offline --audit-level=high",
    "verify": "npm run test && npm run build && npm run audit:offline"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "vite": "^7.1.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
